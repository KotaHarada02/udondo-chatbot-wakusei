# 見本の無料版の設定。この名前で .env.local を作り、値を入れる。.env.local はコミットしない。
# Gemini API の鍵。空なら偽の LLM で動く
GEMINI_API_KEY=
# Supabase。両方空ならメモリに保存し、知識は backend/tenants/udondo/knowledge_sample.yaml を使う
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# fake にすると鍵があっても偽の LLM を使う
BOT_MODE=auto
# IP アドレスをハッシュにするときに混ぜる文字列。長いランダムな文字列にする
IP_HASH_SALT=
